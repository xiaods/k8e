{
  "name": "@k8e-sandbox/dsh-k8e-sandbox-client",
  "version": "0.1.0",
  "description": "k8e-sandbox transport: CLI client (Phase 1) + gRPC terminal client (Phase 2).",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./grpc": {
      "types": "./lib/grpc.d.ts",
      "default": "./lib/grpc.js"
    }
  },
  "files": [
    "lib",
    "proto"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
